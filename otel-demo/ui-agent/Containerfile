# Builds ui-agent.jar with Java 8's javac against the Java 6 class library, so the one jar loads on
# every JVM from 6 up. Output stage is the jar plus the JDK 8 attach files: docker build --output dist .
FROM --platform=linux/amd64 docker.io/azul/zulu-openjdk-debian:6 AS jdk6

FROM --platform=linux/amd64 docker.io/azul/zulu-openjdk:8 AS build
COPY --from=jdk6 /usr/lib/jvm/zulu-6-amd64/jre/lib/rt.jar /jdk6-rt.jar
COPY src /src
COPY MANIFEST.MF /MANIFEST.MF
RUN mkdir /out && \
    javac -source 1.6 -target 1.6 -bootclasspath /jdk6-rt.jar -extdirs "" -encoding UTF-8 -nowarn -Xlint:-options \
          -d /out $(find /src -name '*.java') && \
    jar cfm /ui-agent.jar /MANIFEST.MF -C /out . && \
    java -jar /ui-agent.jar self-check && \
    jar tf /ui-agent.jar | wc -l

FROM scratch
COPY --from=build /ui-agent.jar /ui-agent.jar
# The attach command on a Java 8 JRE (Linux x64) needs these two from a JDK 8, next to the jar.
COPY --from=build /usr/lib/jvm/zulu8/lib/tools.jar /usr/lib/jvm/zulu8/jre/lib/amd64/libattach.so /
