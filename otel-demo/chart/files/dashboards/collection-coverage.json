          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT n.app, n.html_loads, r.initial_loads, r.sessions, round(100.0 * r.initial_loads / n.html_loads) AS pct_with_script FROM (SELECT app, count(*) AS html_loads FROM \"nginx_access\" WHERE method = 'GET' AND status = 200 AND content_type LIKE 'text/html%' AND NOT regexp_like(uri, '^/(api|__poc)/') AND (app IN ($app) OR '_o2_all_' IN ($app)) GROUP BY app) n LEFT JOIN (SELECT service AS app, count(DISTINCT CASE WHEN view_loading_type = 'initial_load' THEN view_id END) AS initial_loads, count(DISTINCT session_id) AS sessions FROM \"_rumdata\" WHERE type = 'view' AND (service IN ($app) OR '_o2_all_' IN ($app)) GROUP BY service) r ON r.app = n.app ORDER BY n.app",
              "vrlFunctionQuery": "",
              "customQuery": true,
              "fields": {
                "stream": "nginx_access",
                "stream_type": "logs",
