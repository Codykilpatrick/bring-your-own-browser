# Desktop image plus one JDK copied out of a vendor image. Old Zulu images sit on EOL Debian
# releases whose apt no longer works, so the JDK moves to the desktop image rather than the other
# way round.
ARG JDK_IMAGE=docker.io/azul/zulu-openjdk:8
FROM --platform=linux/amd64 ${JDK_IMAGE} AS jdk

FROM java-apps/desktop:latest
ARG JDK_HOME=/usr/lib/jvm/zulu8
COPY --from=jdk ${JDK_HOME} /opt/jdk
ENV JAVA_HOME=/opt/jdk
ENV PATH=/opt/jdk/bin:${PATH}
