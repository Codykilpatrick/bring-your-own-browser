# Headless X desktop for running the Java test apps: Xvfb, a window manager, VNC, noVNC on :6080,
# and xdotool for the scripted click lists. The JDK is copied in by jdk/Containerfile.
FROM --platform=linux/amd64 docker.io/library/debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      xvfb fluxbox x11vnc novnc websockify xdotool x11-utils scrot procps curl ca-certificates \
      fonts-dejavu-core fontconfig \
      libxext6 libxrender1 libxtst6 libxi6 libxrandr2 libxxf86vm1 libfreetype6 libfontconfig1 \
      libasound2 libgtk2.0-0 libgtk-3-0 libgl1 libglib2.0-0 libgdk-pixbuf-2.0-0 libpango-1.0-0 libcairo2 \
    && rm -rf /var/lib/apt/lists/*

COPY start-desktop.sh /usr/local/bin/start-desktop.sh
RUN chmod +x /usr/local/bin/start-desktop.sh

ENV DISPLAY=:99
EXPOSE 6080
ENTRYPOINT ["/usr/local/bin/start-desktop.sh"]
