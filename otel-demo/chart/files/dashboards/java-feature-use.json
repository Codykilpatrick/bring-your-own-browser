          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT app, count(*) AS controls, sum(CASE WHEN uses > 0 THEN 1 ELSE 0 END) AS used, sum(CASE WHEN uses = 0 THEN 1 ELSE 0 END) AS never_used, round(100.0 * sum(CASE WHEN uses > 0 THEN 1 ELSE 0 END) / count(*)) AS pct_used FROM (SELECT service AS app, target_page AS screen, target_text AS control, target_element AS kind, count(*) FILTER (WHERE type = 'action') AS uses, count(DISTINCT CASE WHEN type = 'action' THEN session_id END) AS sessions, max(CASE WHEN type = 'action' THEN _timestamp END) AS last_used FROM \"ui_views\" WHERE type IN ('inventory', 'action') AND target_page <> '' AND (service IN ($app) OR '_o2_all_' IN ($app)) GROUP BY service, target_page, target_text, target_element) WHERE control <> '' GROUP BY app ORDER BY app",
