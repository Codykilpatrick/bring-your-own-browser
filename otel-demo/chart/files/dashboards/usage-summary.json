          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT r.app, r.first_seen, r.last_seen, r.days_observed, r.sessions, r.views, concat(cast(p.used AS varchar), ' of ', cast(p.cataloged AS varchar)) AS cataloged_pages_used FROM (SELECT service AS app, min(ts) AS first_seen, max(ts) AS last_seen, count(DISTINCT date_trunc('day', to_timestamp_micros(ts))) AS days_observed, count(DISTINCT session_id) AS sessions, count(DISTINCT CASE WHEN spent >= 1e9 THEN view_id END) AS views FROM (SELECT service, session_id, view_id, regexp_replace(regexp_replace(view_url, '^https?://[^/]+|[?][^#]*', '', 'g'), '(.)/(#|$)', '$1$2') AS path, max(view_time_spent) AS spent, min(_timestamp) AS ts FROM (SELECT service, session_id, view_id, view_url, view_time_spent, view_loading_type, _timestamp FROM \"_rumdata\" WHERE type = 'view' AND (service IN ($app) OR '_o2_all_' IN ($app)) UNION ALL SELECT service, session_id, view_id, view_url, view_time_spent, view_loading_type, _timestamp FROM \"ui_views\" WHERE type = 'view' AND (service IN ($app) OR '_o2_all_' IN ($app))) GROUP BY service, session_id, view_id, path) GROUP BY service) r LEFT JOIN (SELECT app, count(*) AS cataloged, sum(CASE WHEN sessions > 0 THEN 1 ELSE 0 END) AS used FROM (SELECT c.app, c.feature_name AS feature, count(DISTINCT v.session_id) AS sessions, count(DISTINCT CASE WHEN v.spent >= 1e9 THEN v.view_id END) AS views, to_char(to_timestamp_micros(max(v.ts)), '%Y-%m-%d %H:%M') AS last_used_utc, c.feature_id FROM enrich.feature_catalog c LEFT JOIN (SELECT service, session_id, view_id, regexp_replace(regexp_replace(view_url, '^https?://[^/]+|[?][^#]*', '', 'g'), '(.)/(#|$)', '$1$2') AS path, max(view_time_spent) AS spent, min(_timestamp) AS ts FROM (SELECT service, session_id, view_id, view_url, view_time_spent, view_loading_type, _timestamp FROM \"_rumdata\" WHERE type = 'view' AND (service IN ($app) OR '_o2_all_' IN ($app)) UNION ALL SELECT service, session_id, view_id, view_url, view_time_spent, view_loading_type, _timestamp FROM \"ui_views\" WHERE type = 'view' AND (service IN ($app) OR '_o2_all_' IN ($app))) GROUP BY service, session_id, view_id, path) v ON v.service = c.app AND regexp_like(v.path, c.path_pattern) WHERE c.kind = 'page' AND (c.app IN ($app) OR '_o2_all_' IN ($app)) GROUP BY c.app, c.feature_name, c.feature_id) GROUP BY app) p ON p.app = r.app ORDER BY r.app",
              "vrlFunctionQuery": "",
