          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT i.app, i.interactions, i.clicks, i.changes_and_submits, w.write_control_uses, concat(cast(w.used AS varchar), ' of ', cast(w.cataloged AS varchar)) AS cataloged_controls_used FROM (SELECT service_name AS app, count(*) AS interactions, count(*) FILTER (WHERE event_type = 'click') AS clicks, count(*) FILTER (WHERE event_type IN ('change', 'submit')) AS changes_and_submits FROM \"default\" s WHERE s.event_type IN ('click', 'change', 'submit') AND (service_name IN ($app) OR '_o2_all_' IN ($app)) GROUP BY service_name) i LEFT JOIN (SELECT app, sum(CASE WHEN writes = 'y' THEN uses ELSE 0 END) AS write_control_uses, sum(CASE WHEN uses > 0 THEN 1 ELSE 0 END) AS used, count(*) AS cataloged FROM (SELECT c.app, c.feature_name AS feature, c.element_label AS label, c.writes, count(s.span_id) AS uses, count(DISTINCT s.rum_session_id) AS sessions, to_char(to_timestamp_micros(max(s._timestamp)), '%Y-%m-%d %H:%M') AS last_used_utc, c.feature_id FROM enrich.feature_catalog c LEFT JOIN \"default\" s ON s.service_name = c.app AND s.event_type IN ('click', 'change', 'submit') AND s.target_text = c.element_label AND regexp_like(regexp_replace(s.page_path, '(.)/$', '$1'), c.path_pattern) WHERE c.kind = 'control' AND (c.app IN ($app) OR '_o2_all_' IN ($app)) GROUP BY c.app, c.feature_name, c.element_label, c.writes, c.feature_id) GROUP BY app) w ON w.app = i.app ORDER BY i.app",
