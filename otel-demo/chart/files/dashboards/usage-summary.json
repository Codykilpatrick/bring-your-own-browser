              "query": "SELECT app, feature, sessions, views FROM (SELECT c.app, c.feature_name AS feature, count(DISTINCT v.session_id) AS sessions, count(DISTINCT CASE WHEN v.spent >= 1e9 THEN v.view_id END) AS views, to_char(to_timestamp_micros(max(v.ts)), '%Y-%m-%d %H:%M') AS last_used_utc, c.feature_id FROM enrich.feature_catalog c LEFT JOIN (SELECT service, session_id, view_id, regexp_replace(regexp_replace(view_url, '^https?://[^/]+|[?][^#]*', '', 'g'), '(.)/(#|$)', '$1$2') AS path, max(view_time_spent) AS spent, min(_timestamp) AS ts FROM (SELECT service, session_id, view_id, view_url, view_time_spent, view_loading_type, _timestamp FROM \"_rumdata\" WHERE type = 'view' AND (service IN ($app) OR '_o2_all_' IN ($app)) UNION ALL SELECT service, session_id, view_id, view_url, view_time_spent, view_loading_type, _timestamp FROM \"ui_views\" WHERE type = 'view' AND (service IN ($app) OR '_o2_all_' IN ($app))) GROUP BY service, session_id, view_id, path) v ON v.service = c.app AND regexp_like(v.path, c.path_pattern) WHERE c.kind = 'page' AND (c.app IN ($app) OR '_o2_all_' IN ($app)) GROUP BY c.app, c.feature_name, c.feature_id) WHERE sessions > 0 ORDER BY sessions DESC, views DESC LIMIT 10",
